// The deck's version of the blog post's augmented-loop.dot: Karpathy's loop (the deck's autoresearch-loop.svg) with
// every lab file (except data/) on the box that uses it. Colours follow Karpathy's diagram exactly (green: propose,
// decide, keep; grey: everything else; dashed: done by you), and orange marks only what is new: a whole orange box is
// a new step; orange words in a grey box are an existing step, changed. Re-render with:
//   dot -Tsvg figures/loop/augmented-loop-files.dot -o images/alpha-augmented-loop-files.svg
digraph augmented {
  rankdir=TB;
  bgcolor="transparent";
  pad=0.25;
  nodesep=0.30;
  ranksep=0.55;
  fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace";
  node [shape=box, style="rounded,filled", fillcolor="#131927", color="#2a3344",
        fontcolor="#e8eaf0", fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace",
        fontsize=14, margin="0.10,0.14", penwidth=1.2, width=2.3, height=0.95, fixedsize=true];
  edge [color="#6b7280", arrowsize=0.7, penwidth=1.1,
        fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace",
        fontsize=13, fontcolor="#9aa1ad"];

  // existing steps (Karpathy's), with any change in orange
  PM   [label=<you write the program<br/><font color="#ffb347">beliefs: mechanism,<br/>counterparty, paper,<br/>prediction</font><br/>(program.md)>,
        style="rounded,dashed", color="#9aa1ad", width=2.9, height=1.25, fontsize=13];
  READ [label=<read alpha.qex<br/><font color="#ffb347">explore 1999-2003<br/>(explore.py)</font>>, width=2.5];
  H    [label="propose\na change", fillcolor="#3ee87a", color="#3ee87a", fontcolor="#0a0e1a"];
  P    [label="edit alpha.qex\nand git commit"];
  X    [label=<trial.sh runs eval.py<br/><font color="#ffb347">50 random purged<br/>partitions of<br/>2004-2017</font>>, width=2.5, height=1.1, fontsize=13];
  R    [label=<score<br/><font color="#ffb347">fitness - charge per node,<br/>median and worst fold</font>>, width=2.9, fontsize=12];
  D    [shape=diamond, style="filled", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a",
        label=<<font color="#ffb347">median up by<br/>&gt; noise, worst<br/>down &lt;= noise,<br/>still eligible?</font>>, margin="0.04,0.02", fontsize=11, width=2.8, height=1.4, fixedsize=true];
  T    [label="keep it", shape=hexagon, style="filled", fillcolor="#0a0e1a",
        color="#3ee87a", fontcolor="#3ee87a", margin="0.04,0.02", width=2.2, height=0.85, fixedsize=true];
  LOG  [label=<log the attempt<br/><font color="#ffb347">claim, outcome,<br/>regime split;<br/>count the trials</font><br/>(results.tsv)>, width=2.4, height=1.25, fontsize=12];
  YOU  [label="you read the\nnotebook", style="rounded,dashed", color="#9aa1ad"];

  // new steps
  C    [label="write the claim:\nwhich belief,\nwhat should move\n(notes.md)", color="#ffb347", fontcolor="#ffb347", fontsize=13, height=1.05];
  SUM  [label="write the\nreport\n(summary.md)", color="#ffb347", fontcolor="#ffb347", fontsize=13];
  OOS  [label="you run 2018-2026,\nonce, at the end\n(test.py)", style="rounded,dashed", color="#ffb347", fontcolor="#ffb347", width=2.6, fontsize=13];

  { rank=same; PM; READ; H; C; P; }
  { rank=same; T; D; R; X; }
  { rank=same; YOU; LOG; SUM; OOS; }

  PM -> READ;
  READ -> H;
  H -> C;
  C -> P;
  P -> X;
  R -> X [dir=back];
  D -> R [dir=back];
  T -> D [dir=back, label="yes", fontcolor="#3ee87a"];
  T -> READ [style=dashed, label="next  ", constraint=false, fontcolor="#9aa1ad"];
  D -> READ [label="  no: git checkout\n  <best> -- alpha.qex", constraint=false, color="#ff6b4a", fontcolor="#ff6b4a"];
  D -> LOG [label="every attempt,\nkept or not"];
  YOU -> LOG [dir=back, style=dashed];
  YOU -> PM [constraint=false, style=dashed, label="revise", fontcolor="#9aa1ad"];
  LOG -> SUM [style=dashed, label="after the\nlast trial"];
  SUM -> OOS [style=dashed];
}
